# ==============================================================================
# JTC CARNIVAL — PRODUCTION ENVIRONMENT CONFIGURATION (.env.prod)
# ==============================================================================
# Copy this file to .env.prod on your production server:
# cp .env.prod.example .env.prod
# And fill in your secure production credentials.

# ─── Domain & Core Settings ───────────────────────────────────────────────────
DOMAIN=jtc.sjis.edu.bd
FRONTEND_URL=https://jtc.sjis.edu.bd
BACKEND_URL=https://jtc.sjis.edu.bd

# Set to False in production
DEBUG=False

# Generate a strong 64-char key: openssl rand -base64 48
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key-prod-2026

# Comma-separated allowed host domains
ALLOWED_HOSTS=jtc.sjis.edu.bd,www.jtc.sjis.edu.bd,localhost,127.0.0.1,backend,frontend

# Whitelist your exact frontend origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://jtc.sjis.edu.bd,https://www.jtc.sjis.edu.bd
CSRF_TRUSTED_ORIGINS=https://jtc.sjis.edu.bd,https://www.jtc.sjis.edu.bd

# ─── PostgreSQL Database (Docker Internal) ────────────────────────────────────
POSTGRES_DB=jtc_carnival_db
POSTGRES_USER=jtc_admin
POSTGRES_PASSWORD=your_strong_database_password_here

# ─── Frontend Next.js Public Config ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...your_cloudflare_turnstile_site_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=557068883318-78gk6amnr0fsm75nnslh9n5pq2mrnkn2.apps.googleusercontent.com

# ─── Google OAuth & Session JWT ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=557068883318-78gk6amnr0fsm75nnslh9n5pq2mrnkn2.apps.googleusercontent.com
# SESSION_JWT_SECRET is optional (auto-generated in production if left blank)
# SESSION_JWT_SECRET=your_custom_secret_key

# ─── Cloudflare Turnstile Bot Defense ─────────────────────────────────────────
CLOUDFLARE_TURNSTILE_ENABLED=False
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...your_cloudflare_turnstile_secret_key

# ─── SSL / Security Hardening ─────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True

# ─── SMTP Email Configuration ─────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=jtc@sjis.edu.bd
EMAIL_HOST_PASSWORD=your_google_app_password
DEFAULT_FROM_EMAIL="Josephite Tech Club <jtc@sjis.edu.bd>"

# ─── GreenWeb SMS Gateway (Bangladesh) ────────────────────────────────────────
GREENWEB_SMS_ENABLED=True
GREENWEB_SMS_USER=your_greenweb_username
GREENWEB_SMS_PASS=your_greenweb_token
GREENWEB_SMS_FROM=JTCSJIS

# ─── SSLCommerz Payment Gateway ───────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_live_store_id
SSLCOMMERZ_STORE_PASS=your_live_store_password
SSLCOMMERZ_IS_SANDBOX=False
