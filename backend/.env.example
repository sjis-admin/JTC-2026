# ==========================================
# JTC CARNIVAL BACKEND PRODUCTION CONFIGURATION
# ==========================================

# Set to False in production
DEBUG=False

# Generate a strong 64-char secret: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-this-to-a-cryptographically-secure-random-secret-key

# Comma-separated allowed host domains
ALLOWED_HOSTS=jtc.sjis.edu.bd,www.jtc.sjis.edu.bd

# Whitelist your exact frontend origin
CORS_ALLOWED_ORIGINS=https://jtc.sjis.edu.bd

# Production PostgreSQL Database URL (e.g., postgresql://username:strong_password@127.0.0.1:5432/jtc_prod_db)
DATABASE_URL=postgresql://jtc_admin:your_secure_db_password@127.0.0.1:5432/jtc_carnival_db

# Cloudflare Turnstile Bot Defense (Set to True in production)
CLOUDFLARE_TURNSTILE_ENABLED=False
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAA...your_cloudflare_turnstile_secret_key

# SSL & HTTPS Hardening (Set to True behind Nginx/Caddy with SSL)
SECURE_SSL_REDIRECT=True

# SMTP Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=jtc@sjis.edu.bd
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=Josephite Tech Club <jtc@sjis.edu.bd>

# GreenWeb SMS Gateway (Bangladesh)
GREENWEB_SMS_ENABLED=True
GREENWEB_SMS_USER=your_greenweb_username
GREENWEB_SMS_PASS=your_greenweb_token
GREENWEB_SMS_FROM=JTCSJIS

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=your_live_store_id
SSLCOMMERZ_STORE_PASS=your_live_store_password
SSLCOMMERZ_IS_SANDBOX=False
FRONTEND_URL=https://jtc.sjis.edu.bd
BACKEND_URL=https://jtc.sjis.edu.bd
